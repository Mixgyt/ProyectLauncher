<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="115"
             x:Class="ProyectLauncher.Views.Beta.ServerStatus" Background="DarkSlateGray">
  <StackPanel Margin="10" Orientation="Horizontal">
      <StackPanel Margin="0,5" Width="200">
            <TextBlock Name="LblTitleServer"
                 FontSize="25"
                 FontWeight="Bold"
          Text="Server..."/>
          <TextBlock Name="LblSubtitle" Margin="0,5" TextWrapping="Wrap" Text="Subtitulo del servidor de minecraft"/>
      </StackPanel>
      <Image Name="PicIcon" Margin="10,0" Source="avares://ProyectLauncher/Assets/pino.ico" Width="75"/>
      <StackPanel Margin="5" VerticalAlignment="Center">
          <TextBlock Text="Jugadores"/>
          <TextBlock Name="LblPlayers" Text="0/1" HorizontalAlignment="Center"/>
      </StackPanel>
  </StackPanel>
</UserControl>
