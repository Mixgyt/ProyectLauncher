{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-desktop",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PinoLauncher.Desktop/PinoLauncher.Desktop.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-desktop-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PinoLauncher.Desktop/PinoLauncher.Desktop.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "publish-desktop-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/PinoLauncher.Desktop/PinoLauncher.Desktop.csproj",
                "--configuration",
                "Release",
                "--output",
                "${workspaceFolder}/publish/win-x64"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "publish-single-exe",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/PinoLauncher.Desktop/PinoLauncher.Desktop.csproj",
                "--configuration",
                "Release",
                "--runtime",
                "win-x64",
                "--self-contained",
                "true",
                "/p:PublishSingleFile=true",
                "/p:PublishReadyToRun=true",
                "/p:EnableCompressionInSingleFile=true",
                "--output",
                "${workspaceFolder}/publish/single-exe"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/PinoLauncher.sln"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}