<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PinoLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="PinoLauncher.Views.ModLoaderConfigWindow"
        x:DataType="vm:ModLoaderConfigViewModel"
        Title="Configuración de Mod Loaders"
        Width="600"
        Height="500"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Icon="/Assets/avalonia-logo.ico">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Título -->
    <StackPanel Grid.Row="0" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                Margin="0,0,0,20">
      <LucideIcon Kind="Cog" StrokeWidth="2" Size="24" Margin="0,0,5,0" VerticalAlignment="Center"/>
      <TextBlock Text="Configuración de Mod Loaders" 
                 FontSize="20" 
                 FontWeight="Bold" 
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource CustomPrimaryBrush}"/>
    </StackPanel>

    <!-- Activar/Desactivar Mod Loader -->
    <Border Grid.Row="1" 
            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}" 
            CornerRadius="8" 
            Padding="15" 
            Margin="0,0,0,15">
      <StackPanel>
        <CheckBox Content="Habilitar Mod Loader" 
                  IsChecked="{Binding EnableModLoader}"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Margin="0,0,0,10"/>
        <TextBlock Text="Permite cargar mods en Minecraft usando el mod loader seleccionado." 
                   FontSize="12" 
                   Foreground="{DynamicResource SystemBaseMediumBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Configuración principal -->
    <Border Grid.Row="2" 
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
            CornerRadius="8" 
            Padding="20" 
            IsEnabled="{Binding EnableModLoader}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Selección de Mod Loader -->
        <TextBlock Grid.Row="0" 
                   Text="Tipo de Mod Loader:" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <ComboBox Grid.Row="1" 
                  ItemsSource="{Binding AvailableModLoaders}"
                  SelectedItem="{Binding SelectedModLoader}"
                  Margin="0,0,0,15"
                  PlaceholderText="Selecciona un mod loader">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" 
                           FontSize="11" 
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Versión del Mod Loader -->
        <TextBlock Grid.Row="2" 
                   Text="Versión del Mod Loader:" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <ComboBox Grid.Row="3" 
                  ItemsSource="{Binding AvailableVersionsForLoader}"
                  SelectedItem="{Binding SelectedLoaderVersion}"
                  Margin="0,0,0,15"
                  PlaceholderText="Selecciona una versión"/>

        <!-- Información del mod loader seleccionado -->
        <TextBlock Grid.Row="4" 
                   Text="Información:" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border Grid.Row="5" 
                CornerRadius="5" 
                Padding="10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{Binding SelectedModLoaderInfo}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
                <LucideIcon Kind="Lightbulb" StrokeWidth="2" Size="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Tip: Los mods deben ser compatibles con la versión de Minecraft y el mod loader seleccionados."
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource SystemBaseMediumBrush}"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>

    <!-- Botones de acción -->
    <Border Grid.Row="4" 
            Margin="0,15,0,0">
      <StackPanel Orientation="Horizontal" 
                  HorizontalAlignment="Right">
        <Button Command="{Binding ResetToDefaultsCommand}"
                Margin="0,0,10,0"
                Padding="15,8"
                Background="#FFC107"
                Foreground="White"
                CornerRadius="5">
          <StackPanel Orientation="Horizontal">
            <LucideIcon Kind="RefreshCcw" StrokeWidth="2" Size="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock Text="Restablecer" 
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding ApplySettingsCommand}"
                Margin="0,0,10,0"
                Padding="15,8"
                Background="#4CAF50"
                Foreground="White"
                CornerRadius="5">
          <StackPanel Orientation="Horizontal">
            <LucideIcon Kind="Check" StrokeWidth="2" Size="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock Text="Aplicar Configuración" 
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Click="CloseButton_Click"
                Padding="15,8"
                Background="#6c757d"
                Foreground="White"
                CornerRadius="5">
          <StackPanel Orientation="Horizontal">
            <LucideIcon Kind="X" StrokeWidth="2" Size="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock Text="Cerrar" 
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>